# Copy this file to android/keystore.properties and fill in YOUR values.
# android/keystore.properties is git-ignored: NEVER commit the real file,
# the keystore, or any password to git.
#
# storeFile may be absolute, or relative to android/app
# (e.g. ../anba-bishoy-release.keystore).
storeFile=/absolute/path/to/your-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
